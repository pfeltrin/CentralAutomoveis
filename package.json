{
  "name": "centralautomoveis",
  "version": "1.0.0",
  "description": "Sistema Central Automoveis",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Patrick Feltrin",
  "license": "ISC",
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "central.automoveis",
    "productName": "Central Automoveis",
    "asar": true,
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "npmRebuild": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "backend/**/*",
      "frontend/**/*",
      "database/**/*",
      "electron/**/*",
      "package.json",
      "!dist/**/*",
      "!node_modules/*/{CHANGELOG,README,test,example,examples}*",
      "!node_modules/.bin/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Central Automoveis",
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "artifactName": "${productName} Setup ${version} ${arch}.exe"
    }
  }
}